# Lấy ở developers.facebook.com > App của bạn > Cài đặt ứng dụng > Thông tin cơ bản
FB_APP_ID=
FB_APP_SECRET=

# Chỉ điền nếu app dùng Facebook Login for Business: ID cấu hình đăng nhập (Configuration ID).
# Để trống thì server xin quyền bằng danh sách scope trong server.js.
FB_CONFIG_ID=

# Phiên bản Graph API. Đặt bằng phiên bản mới nhất đang hiển thị trong trang App Dashboard.
GRAPH_VERSION=v23.0

PORT=3000
# Địa chỉ người dùng mở dashboard. Phải khớp với redirect URI đã khai báo trong app Meta.
BASE_URL=http://localhost:3000
# Chỉ nghe trên máy này. Đổi thành 0.0.0.0 khi đã có đăng nhập cho dashboard.
HOST=127.0.0.1

# ---------- Agent research (npm run agent:research) ----------
# Khóa API Anthropic, lấy ở console.anthropic.com > API Keys. Bỏ dấu # rồi dán khóa.
# Để trống thì đừng bỏ dấu #: một dòng rỗng sẽ chặn các cách đăng nhập khác của SDK.
# ANTHROPIC_API_KEY=
# Địa chỉ server AUTOFB mà agent hỏi việc.
AUTOFB_URL=http://localhost:3000
# Chỉ cần khi hệ thống có nhiều agent research; để trống thì dùng agent research duy nhất.
RESEARCH_AGENT_ID=
# Mô hình và mức suy nghĩ (low, medium, high, xhigh, max). high là cân bằng giữa chất lượng và chi phí.
RESEARCH_MODEL=claude-opus-5-5
RESEARCH_EFFORT=high
# Bao lâu hỏi việc một lần, tính bằng giây.
POLL_SECONDS=60

# ---------- Nguồn cho agent research (không bắt buộc) ----------
# Có khóa thì agent đọc Reddit, YouTube qua API chính thức; không có thì đọc trang web công khai.
# Reddit: reddit.com/prefs/apps > create another app > loại "script". Client ID nằm dưới tên app.
# Dùng cho mục đích kinh doanh cần xem điều khoản Data API của Reddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit yêu cầu User-Agent có tên tài khoản Reddit của bạn, ví dụ: windows:autofb-research:0.1 (by /u/ten_ban)
REDDIT_USER_AGENT=
# YouTube: console.cloud.google.com > bật YouTube Data API v3 > Credentials > API key. Hạn mức miễn phí 10.000 đơn vị/ngày.
YOUTUBE_API_KEY=

# ---------- Agent designer (npm run agent:designer) ----------
# Vẽ ảnh mẫu (moodboard) cho đề xuất kênh bằng API tạo ảnh của OpenAI. Lấy khóa ở platform.openai.com > API keys.
# OPENAI_API_KEY=
# Mô hình ảnh và chất lượng. low là ảnh nháp, rẻ và nhanh, đủ để hình hóa ý tưởng. Đổi mô hình nếu OpenAI báo không nhận.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1536x1024
# Chỉ cần khi hệ thống có nhiều Agent designer.
DESIGNER_AGENT_ID=

# ---------- B-roll cho Reel (tùy chọn) ----------
# Clip stock có giấy phép, dùng miễn phí cho đăng thương mại. Lấy khóa miễn phí ở pexels.com/api (bấm Get Started).
PEXELS_API_KEY=
# Thêm nguồn phụ: pixabay.com/api/docs (đăng nhập sẽ thấy khóa).
PIXABAY_API_KEY=

# Muse (muse2api tự lưu trữ): tạo cảnh quay AI cho Reel và làm việc đơn giản thay Claude
MUSE2API_BASE=http://127.0.0.1:18610
MUSE_API_KEY=
# Số cảnh Muse tối đa mỗi ngày (mặc định 30)
MUSE_MAX_PER_DAY=60
# Đặt 0 để tắt việc giao Muse làm thay Claude
MUSE_TEXT=1
